# ─── Database (Neon Postgres via Vercel) ─────────────────────────────────────
# Pooled connection (used by Prisma at runtime via pgBouncer)
DATABASE_URL="your-neon-pooled-connection-string"
# Direct connection (used by Prisma for migrations/db push)
DATABASE_URL_UNPOOLED="your-neon-direct-connection-string"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Get your API key at https://resend.com — free tier is enough to start
RESEND_API_KEY="re_your_api_key_here"

# Single "from" address used on ALL outgoing email (all 5 sends).
# Must be on a domain you've verified in Resend. Display name is optional.
FROM_EMAIL="Your Brand <hello@yourdomain.com>"

# Comma-separated admin addresses. Used as the recipients on order / contact /
# out-of-area notifications AND as the Reply-To on customer-facing emails
# (order confirmation, contact auto-reply). Whitespace around commas is trimmed.
ADMIN_NOTIFY_EMAILS="owner@example.com, alerts@yourdomain.com"

# ─── Site URL ────────────────────────────────────────────────────────────────
# No trailing slash
NEXT_PUBLIC_SITE_URL="https://dtlawater.com"

# ─── Admin Login ─────────────────────────────────────────────────────────────
# Change both of these before deploying to production
ADMIN_USERNAME="joseph"
ADMIN_PASSWORD="choose-a-strong-password-here"

# ─── Session Secret ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Keep this secret.
SESSION_SECRET="replace-this-with-a-random-64-character-string"

# ─── Google Analytics 4 ──────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-860S27DESN
